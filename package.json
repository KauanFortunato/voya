{
  "name": "voya",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "tsx watch --env-file=.env server/index.ts",
    "build": "tsc -b && vite build",
    "db:provision": "tsx --env-file=.env server/db/provision.ts",
    "db:migrate": "tsx --env-file=.env server/db/migrate.ts",
    "db:seed": "tsx --env-file=.env server/db/seed.ts",
    "db:seed-trip": "tsx --env-file=.env server/db/seed-trip.ts",
    "data:import": "node scripts/import-trip.mjs",
    "lint": "oxlint",
    "test": "tsx --test server/**/*.test.ts",
    "start:api": "tsx --env-file=.env server/index.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/multipart": "^10.1.0",
    "fastify": "^5.11.3",
    "lucide-react": "^1.30.0",
    "motion": "^13.0.0",
    "postgres": "^3.4.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-pdf": "^10.4.1",
    "react-router-dom": "^7.18.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "tsx": "^4.23.12",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
